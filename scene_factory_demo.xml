<mujoco model="g1 factory demo">
  <include file="g1_29dof.xml"/>

  <statistic center="4 0 0.9" extent="8"/>

  <visual>
    <headlight diffuse="0.35 0.35 0.38" ambient="0.12 0.12 0.15" specular="0.1 0.1 0.1"/>
    <rgba haze="0.04 0.06 0.09 1"/>
    <global azimuth="-125" elevation="-18"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.04 0.06 0.10" rgb2="0.005 0.008 0.015" width="512" height="3072"/>
    <texture type="2d" name="floor_tex" builtin="checker" mark="edge"
             rgb1="0.16 0.17 0.19" rgb2="0.10 0.11 0.13" markrgb="0.35 0.38 0.42"
             width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texuniform="true" texrepeat="16 8" reflectance="0.08"/>
    <material name="shelf_mat" rgba="0.22 0.26 0.30 1"/>
    <material name="safety_yellow" rgba="0.95 0.65 0.08 1"/>
    <material name="inspection_green" rgba="0.10 0.65 0.35 1"/>
    <material name="route_blue" rgba="0.15 0.55 0.95 0.45"/>
  </asset>

  <worldbody>
    <light pos="1 0 5" dir="0 0 -1" directional="true" diffuse="0.45 0.48 0.55"/>
    <light pos="6 0 4" dir="0 0 -1" directional="false" diffuse="0.30 0.34 0.40"/>
    <geom name="factory_floor" type="plane" size="20 10 0.05" material="floor_mat"/>

    <!-- Route guide -->
    <geom name="route_1" type="box" pos="2 0 0.006" size="2 0.035 0.006" material="route_blue" contype="0" conaffinity="0"/>
    <geom name="route_2" type="box" pos="6 0 0.006" size="2 0.035 0.006" material="route_blue" contype="0" conaffinity="0"/>

    <!-- 85cm-class narrow aisle visualized by two shelf rows -->
    <geom name="shelf_left_base" type="box" pos="4 0.76 0.75" size="3.0 0.28 0.75" material="shelf_mat"/>
    <geom name="shelf_right_base" type="box" pos="4 -0.76 0.75" size="3.0 0.28 0.75" material="shelf_mat"/>
    <geom type="box" pos="2.3 0.76 1.75" size="0.75 0.28 0.20" material="safety_yellow"/>
    <geom type="box" pos="4.0 0.76 1.75" size="0.75 0.28 0.20" material="safety_yellow"/>
    <geom type="box" pos="5.7 0.76 1.75" size="0.75 0.28 0.20" material="safety_yellow"/>
    <geom type="box" pos="2.3 -0.76 1.75" size="0.75 0.28 0.20" material="safety_yellow"/>
    <geom type="box" pos="4.0 -0.76 1.75" size="0.75 0.28 0.20" material="safety_yellow"/>
    <geom type="box" pos="5.7 -0.76 1.75" size="0.75 0.28 0.20" material="safety_yellow"/>

    <!-- 7 degree ramp -->
    <geom name="ramp_7deg" type="box" pos="8.0 0 0.12" size="1.0 0.55 0.08"
          euler="0 -7 0" rgba="0.35 0.37 0.40 1"/>

    <!-- 15 mm step -->
    <geom name="step_15mm" type="box" pos="10.0 0 0.0075" size="0.45 0.6 0.0075" rgba="0.55 0.55 0.58 1"/>

    <!-- Static forklift obstacle / mixed traffic marker -->
    <body name="forklift_demo" pos="11.5 1.7 0">
      <geom type="box" pos="0 0 0.35" size="0.65 0.42 0.35" material="safety_yellow"/>
      <geom type="box" pos="-0.20 0 0.95" size="0.28 0.36 0.48" rgba="0.18 0.20 0.22 1"/>
      <geom type="cylinder" pos="-0.42 0.45 0.20" size="0.18 0.10" euler="90 0 0" rgba="0.05 0.05 0.05 1"/>
      <geom type="cylinder" pos="0.42 0.45 0.20" size="0.18 0.10" euler="90 0 0" rgba="0.05 0.05 0.05 1"/>
      <geom type="box" pos="0.85 0 0.18" size="0.55 0.06 0.04" rgba="0.75 0.75 0.78 1"/>
    </body>

    <!-- Inspection station -->
    <body name="inspection_station" pos="13 -1.8 0">
      <geom type="box" pos="0 0 0.9" size="0.45 0.45 0.9" rgba="0.18 0.23 0.30 1"/>
      <geom type="sphere" pos="0 -0.46 1.30" size="0.08" material="inspection_green"/>
      <light pos="0 -0.6 1.6" dir="0 1 -0.2" diffuse="0.2 0.9 0.45"/>
    </body>

    <camera name="customer_main" mode="targetbody" target="pelvis" pos="-3.2 -4.8 2.25"/>
    <camera name="customer_side" mode="targetbody" target="pelvis" pos="0 -5.4 1.65"/>
    <camera name="customer_overview" mode="targetbody" target="pelvis" pos="-1.5 -7.8 5.5"/>
  </worldbody>
</mujoco>